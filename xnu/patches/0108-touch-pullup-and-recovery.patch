+/* ------------------------------------------------------------------------ */
+/* 0098-touch-pullup: S-Boot leaves the gpp pads pulled down / floating.     */
+/* Linux's pinctrl sets pull-ups on the i2c pads; bit-banging needs them     */
+/* too, otherwise SCL/SDA idle low, every address ACKs and every read is 0. */
+
+static uint32_t ts_pud_used[2];
+
+static int
+bus_idle_high(struct bbi2c *b)
+{
+	i2c_scl(b, 1);
+	i2c_sda(b, 1);
+	sleep_us(300);
+	return pin_get(b->bank_va, b->scl_bit) && pin_get(b->bank_va, b->sda_bit);
+}
+
+/* returns the PUD field width that made both lines idle high, or 0 */
+static int
+bus_pullup(struct bbi2c *b, int which)
+{
+	uint32_t orig = *(volatile uint32_t *)(b->bank_va + REG_PUD);
+
+	if (bus_idle_high(b)) {
+		ts_pud_used[which] = orig;
+		return 1; /* already high */
+	}
+	for (int w = 2; w <= 4; w += 2) {
+		uint32_t v = orig, m = (1U << w) - 1U;
+		uint32_t pins[2] = { b->scl_bit, b->sda_bit };
+		for (int i = 0; i < 2; i++) {
+			v = (v & ~(m << (pins[i] * (uint32_t)w))) | (3U << (pins[i] * (uint32_t)w));
+		}
+		*(volatile uint32_t *)(b->bank_va + REG_PUD) = v;
+		sleep_us(300);
+		if (bus_idle_high(b)) {
+			ts_pud_used[which] = v;
+			return w;
+		}
+	}
+	*(volatile uint32_t *)(b->bank_va + REG_PUD) = orig;
+	ts_pud_used[which] = orig;
+	return 0;
+}
+
+/* free a slave that is holding SDA low: up to 9 SCL pulses, then STOP */
+static void
+bus_recover(struct bbi2c *b)
+{
+	i2c_sda(b, 1);
+	for (int i = 0; i < 9 && !pin_get(b->bank_va, b->sda_bit); i++) {
+		i2c_scl(b, 0); sleep_us(10);
+		i2c_scl(b, 1); sleep_us(10);
+	}
+	i2c_start(b);
+	i2c_stop(b);
+}
+
+/* ------------------------------------------------------------------------ */
+/* S21 5G (o1s): tsp_io = S2MPS23 LDO27 (1.8 V), tsp_avdd = S2MPS24 LDO21    */
+/* (3.0 V). Both PMICs sit behind the APM firmware: ACPM IPC channel 2       */
+/* (acpm-mfd-bus), mfd channel 0 = S2MPS23, 1 = S2MPS24, type 1 = PMIC page. */
+/* Protocol from the SM-G991N kernel (drivers/soc/samsung/acpm/acpm_ipc.c,   */
+/* acpm_mfd.c); addresses from its exynos2100 DT (acpm_ipc node).            */
+
+#define ACPM_SRAM_BASE   0x02039000U
+#define ACPM_SRAM_SIZE   0x41000U
+#define ACPM_INITDATA    0x8000U
+#define ACPM_MBOX_BASE   0x15900000U
+#define ACPM_INTGR0      0x08U
+#define ACPM_INTCR1      0x20U
+#define ACPM_MFD_IPC_CH  2U
+#define ACPM_FUNC_READ   0U
+#define ACPM_FUNC_UPDATE 2U
+
+static vm_offset_t acpm_sram, acpm_mbox;
+static uint32_t acpm_seq;
+static int acpm_ok;
+static struct {
+	uint32_t id, txr, txf, txb, rxr, rxf, rxb, len, sz;
+} acpm_ch;
+
+static inline uint32_t
+sram_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(acpm_sram + off);
+}
+
+static inline void
+sram_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(acpm_sram + off) = v;
+}
+
+static int
+acpm_init(void)
+{
+	if (acpm_ok) {
+		return 0;
+	}
+	acpm_sram = ml_io_map(ACPM_SRAM_BASE, ACPM_SRAM_SIZE);
+	acpm_mbox = ml_io_map(ACPM_MBOX_BASE, 0x1000);
+	uint32_t chans = sram_rd(ACPM_INITDATA + 8);   /* acpm_framework.ipc_channels */
+	uint32_t apmax = sram_rd(ACPM_INITDATA + 24);  /* acpm_framework.ipc_ap_max */
+	if (chans == 0 || chans >= ACPM_SRAM_SIZE || apmax == 0 || apmax > 32) {
+		note("acpm: bad initdata chans=%x apmax=%u", chans, apmax);
+		return -1;
+	}
+	for (uint32_t i = 0; i < apmax; i++) {
+		uint32_t e = chans + i * 72U;          /* sizeof(struct ipc_channel) */
+		if (e + 72U > ACPM_SRAM_SIZE) {
+			break;
+		}
+		if (sram_rd(e) != ACPM_MFD_IPC_CH) {
+			continue;
+		}
+		acpm_ch.id  = ACPM_MFD_IPC_CH;
+		/* AP -> APM goes into the APM's rx queue, replies come in its tx queue */
+		acpm_ch.txr = sram_rd(e + 16 + 0);
+		acpm_ch.txf = sram_rd(e + 16 + 4);
+		acpm_ch.txb = sram_rd(e + 16 + 8);
+		acpm_ch.rxr = sram_rd(e + 16 + 24);
+		acpm_ch.rxf = sram_rd(e + 16 + 28);
+		acpm_ch.rxb = sram_rd(e + 16 + 32);
+		acpm_ch.len = sram_rd(e + 16 + 36);
+		acpm_ch.sz  = sram_rd(e + 16 + 40);
+		if (acpm_ch.len == 0 || acpm_ch.len > 64 || acpm_ch.sz < 8 || acpm_ch.sz > 64 ||
+		    acpm_ch.txb >= ACPM_SRAM_SIZE || acpm_ch.rxb >= ACPM_SRAM_SIZE) {
+			note("acpm: ch2 bad q len=%u sz=%u", acpm_ch.len, acpm_ch.sz);
+			return -1;
+		}
+		acpm_ok = 1;
+		note("acpm: ch2 len=%u sz=%u", acpm_ch.len, acpm_ch.sz);
+		return 0;
+	}
+	note("acpm: ch2 not found (apmax=%u)", apmax);
+	return -1;
+}
+
+/* one acpm-mfd request; -1 on IPC failure, else the reply's cmd[1] */
+static int64_t
+acpm_mfd(uint32_t mfd_ch, uint32_t type, uint32_t reg, uint32_t func, uint32_t val, uint32_t mask)
+{
+	uint32_t cmd[4], front, next;
+
+	if (acpm_init()) {
+		return -1;
+	}
+	if (++acpm_seq >= 64) {
+		acpm_seq = 1;
+	}
+	cmd[0] = (reg & 0xFFU) | ((type & 0xFU) << 8) | ((mfd_ch & 0xFU) << 12) | ((acpm_seq & 0x3FU) << 16);
+	cmd[1] = (func & 0xFFU) | ((val & 0xFFU) << 8) | ((mask & 0xFFU) << 16);
+	cmd[2] = 0;
+	cmd[3] = 0;
+	front = sram_rd(acpm_ch.txf);
+	if (front >= acpm_ch.len) {
+		note("acpm: bad tx front %u", front);
+		return -1;
+	}
+	next = (front + 1) % acpm_ch.len;
+	for (int t = 0; t < 1000 && next == sram_rd(acpm_ch.txr); t++) {
+		sleep_us(100);
+	}
+	if (next == sram_rd(acpm_ch.txr)) {
+		note("acpm: tx full");
+		return -1;
+	}
+	for (uint32_t w = 0; w < acpm_ch.sz / 4; w++) {
+		sram_wr(acpm_ch.txb + acpm_ch.sz * front + w * 4, w < 4 ? cmd[w] : 0);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	sram_wr(acpm_ch.txf, next);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(acpm_mbox + ACPM_INTGR0) = (1U << acpm_ch.id) << 16;
+
+	for (int t = 0; t < 3000; t++) {       /* ~300 ms */
+		uint32_t f = sram_rd(acpm_ch.rxf), i = sram_rd(acpm_ch.rxr);
+		while (i != f && i < acpm_ch.len) {
+			uint32_t e = acpm_ch.rxb + acpm_ch.sz * i;
+			if (((sram_rd(e) >> 16) & 0x3FU) == (acpm_seq & 0x3FU)) {
+				uint32_t c1 = sram_rd(e + 4);
+				sram_wr(acpm_ch.rxr, (i + 1) % acpm_ch.len);
+				*(volatile uint32_t *)(acpm_mbox + ACPM_INTCR1) = 1U << acpm_ch.id;
+				return (int64_t)c1;
+			}
+			i = (i + 1) % acpm_ch.len;
+		}
+		sleep_us(100);
+	}
+	note("acpm: no reply seq %u", acpm_seq);
+	return -1;
+}
+
+static int
+acpm_read(uint32_t mfd_ch, uint32_t reg)
+{
+	int64_t r = acpm_mfd(mfd_ch, 1, reg, ACPM_FUNC_READ, 0, 0);
+	if (r < 0 || ((r >> 24) & 0xFF)) {
+		return -1;
+	}
+	return (int)((r >> 8) & 0xFF);
+}
+
+/* turn on tsp_io (S2MPS23 LDO27 = 0x5F, 1.8 V = vsel 0x2C) then tsp_avdd   */
+/* (S2MPS24 LDO21 = 0x54, 3.0 V = vsel 0x30); opmode 3 (always on) = 0xC0.  */
+/* Only writes when the voltage field already holds the expected code, so  */
+/* a different register map (EVT0 parts) cannot switch on the wrong rail.  */
+static void
+s21_touch_rails(int force)
+{
+	int io = acpm_read(0, 0x5F), av = acpm_read(1, 0x54);
+	note("rails before io=%02x av=%02x", io & 0xFF, av & 0xFF);
+	if (io < 0 || av < 0) {
+		note("rails: acpm read failed (io=%d av=%d)", io, av);
+		return;
+	}
+	if (!force && ((io & 0x3F) != 0x2C || (av & 0x3F) != 0x30)) {
+		note("rails: unexpected vsel, not writing (touch_rail=2 forces)");
+		return;
+	}
+	int64_t r1 = acpm_mfd(0, 1, 0x5F, ACPM_FUNC_UPDATE, 0xC0U | 0x2CU, 0xFF);
+	sleep_us(5000);
+	int64_t r2 = acpm_mfd(1, 1, 0x54, ACPM_FUNC_UPDATE, 0xC0U | 0x30U, 0xFF);
+	sleep_us(30000);
+	note("rails on ret %d/%d after io=%02x av=%02x", r1 < 0 ? -1 : (int)((r1 >> 24) & 0xFF),
+	    r2 < 0 ? -1 : (int)((r2 >> 24) & 0xFF), acpm_read(0, 0x5F) & 0xFF, acpm_read(1, 0x54) & 0xFF);
+}
+
+/* ------------------------------------------------------------------------ */
+/* ------------------------------------------------------------------------ */
+/* GPU step 4 (gpu_diag=3): the GPU's MMU and one WRITE_VALUE job. Page      */
+/* tables and the job live in a 2 MiB RAM window that XNU does not manage    */
+/* (boot-arg gpu_scratch=<phys>, made by mkadt --gpu-scratch). Formats from  */
+/* the Linux panfrost uAPI/registers (LPAE mode) and Mesa's job header.      */
+#define GJ_GR(g, o) (*(volatile uint32_t *)((g) + (o)))
+#define GJ_AS0      0x2400U
+#define GJ_JS1      (0x1800U + 0x80U)
+#define GJ_VA_JOB   0x10000000ULL
+#define GJ_VA_OUT   0x10001000ULL
+
+/* one job: identity (no page tables) or paged; NULL (type 1) or WRITE_VALUE (type 2) */
+static uint32_t gj_leaf = 1;          /* Mali LPAE leaf entries are TYPE_BLOCK (1), not PAGE (3) */
+static uint32_t gj_memattr = 0x8D88;
+static uint32_t gj_jscfg = (3U << 8) | (1U << 10) | (3U << 12) | (8U << 16);
+static uint32_t gj_tt = 3U | (1U << 2);
+
+static void
+gj_run(vm_offset_t g, volatile uint32_t *w, uint64_t sp, uint32_t shp, int identity, int jobtype, const char *tag)
+{
+	uint32_t i, t0, stat = 0;
+	uint64_t jobpa = sp + 0x4000, outpa = sp + 0x5000;
+	uint64_t jobva = identity ? jobpa : GJ_VA_JOB, outva = identity ? outpa : GJ_VA_OUT;
+	const uint64_t ATTR = (3ULL << 8) | (1ULL << 10) | (1ULL << 6) | gj_leaf;
+
+	for (i = 0; i < 0x6000 / 4; i++) {
+		w[i] = 0;
+	}
+	#define PUT64(off, v) do { w[(off) / 4] = (uint32_t)(v); w[(off) / 4 + 1] = (uint32_t)((uint64_t)(v) >> 32); } while (0)
+	PUT64(0x0000U, (sp + 0x1000) | 3ULL);
+	PUT64(0x1000U, (sp + 0x2000) | 3ULL);
+	PUT64(0x2000U + 8U * 0x80U, (sp + 0x3000) | 3ULL);
+	PUT64(0x3000U + 8U * 0U, jobpa | ATTR);
+	PUT64(0x3000U + 8U * 1U, outpa | ATTR);
+	w[0x4000 / 4 + 4] = ((uint32_t)jobtype << 1) | 1U;
+	if (jobtype == 2) {
+		PUT64(0x4000U + 32U, outva);
+		w[0x4000 / 4 + 10] = 6U;
+		PUT64(0x4000U + 48U, 0xC0FFEE01ULL);
+	}
+	w[0x5000 / 4] = 0xDEADBEEFU;
+	#undef PUT64
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	if (identity) {
+		GJ_GR(g, GJ_AS0 + 0x00) = 2U;                /* LPAE ADRMODE_IDENTITY */
+		GJ_GR(g, GJ_AS0 + 0x04) = 0;
+	} else {
+		GJ_GR(g, GJ_AS0 + 0x00) = (uint32_t)(sp | gj_tt);
+		GJ_GR(g, GJ_AS0 + 0x04) = (uint32_t)(sp >> 32);
+	}
+	GJ_GR(g, GJ_AS0 + 0x08) = gj_memattr;
+	GJ_GR(g, GJ_AS0 + 0x0C) = gj_memattr;
+	for (t0 = 0; t0 < 100 && (GJ_GR(g, GJ_AS0 + 0x28) & 1U); t0++) { sleep_us(100); }
+	GJ_GR(g, GJ_AS0 + 0x18) = 1U;
+	for (t0 = 0; t0 < 100 && (GJ_GR(g, GJ_AS0 + 0x28) & 1U); t0++) { sleep_us(100); }
+	GJ_GR(g, 0x2004) = 0xFFFFFFFFU;
+	GJ_GR(g, 0x1004) = 0xFFFFFFFFU;
+	GJ_GR(g, 0x024) = 0xFFFFFFFFU;
+
+	GJ_GR(g, GJ_JS1 + 0x40) = (uint32_t)jobva;
+	GJ_GR(g, GJ_JS1 + 0x44) = (uint32_t)(jobva >> 32);
+	GJ_GR(g, GJ_JS1 + 0x50) = shp & (~shp + 1U);
+	GJ_GR(g, GJ_JS1 + 0x54) = 0;
+	GJ_GR(g, GJ_JS1 + 0x58) = gj_jscfg;
+	GJ_GR(g, GJ_JS1 + 0x60) = 1U;
+	for (t0 = 0; t0 < 100; t0++) {
+		stat = GJ_GR(g, 0x1000);
+		if (stat & ((1U << 1) | (1U << 17))) { break; }
+		sleep_us(1000);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	note("%s: raw=%x %ums js=%x as=%x mmu=%x flt=%x/%x gpu=%x out=%x exc=%x", tag, stat, t0,
+	    GJ_GR(g, GJ_JS1 + 0x24), GJ_GR(g, GJ_AS0 + 0x28), GJ_GR(g, 0x2000),
+	    GJ_GR(g, GJ_AS0 + 0x1C), GJ_GR(g, GJ_AS0 + 0x20), GJ_GR(g, 0x020), w[0x5000 / 4], w[0x4000 / 4]);
+	if (!(stat & ((1U << 1) | (1U << 17)))) {
+		GJ_GR(g, GJ_JS1 + 0x60) = 3U;                /* HARD_STOP */
+		sleep_us(20000);
+		note("%s: after hard stop js=%x raw=%x", tag, GJ_GR(g, GJ_JS1 + 0x24), GJ_GR(g, 0x1000));
+	}
+	GJ_GR(g, 0x1004) = 0xFFFFFFFFU;
+}
+
+static void
+s21_gpu_job(vm_offset_t g, uint64_t sp, uint32_t shp)
+{
+	vm_offset_t m = ml_io_map((vm_offset_t)sp, 0x10000);
+	volatile uint32_t *w = (volatile uint32_t *)m;
+	uint32_t a = 0, skipid = 1;
+
+	/* experiment knobs, so a different try needs no kernel rebuild */
+	if (PE_parse_boot_argn("gpu_leaf", &a, sizeof(a))) { gj_leaf = a; }
+	if (PE_parse_boot_argn("gpu_memattr", &a, sizeof(a))) { gj_memattr = a; }
+	if (PE_parse_boot_argn("gpu_jscfg", &a, sizeof(a))) { gj_jscfg = a; }
+	if (PE_parse_boot_argn("gpu_tt", &a, sizeof(a))) { gj_tt = a; }
+	if (PE_parse_boot_argn("gpu_identity", &a, sizeof(a))) { skipid = !a; }
+	note("gpu4: leaf=%u memattr=%x jscfg=%x tt=%x", gj_leaf, gj_memattr, gj_jscfg, gj_tt);
+	if (!skipid) {
+		gj_run(g, w, sp, shp, 1, 1, "id-null");
+		gj_run(g, w, sp, shp, 1, 2, "id-wr");
+	}
+	gj_run(g, w, sp, shp, 0, 1, "pg-null");
+	gj_run(g, w, sp, shp, 0, 2, "pg-wr");
+	GJ_GR(g, GJ_AS0 + 0x00) = 0;
+	GJ_GR(g, GJ_AS0 + 0x04) = 0;
+	GJ_GR(g, GJ_AS0 + 0x18) = 1U;
+}
+
+/* GPU bring-up step 1 (boot-arg gpu_diag=1), read only: the G3D power      */
+/* domain's CONFIGURATION (0x2300) and STATUS (0x2304) in PMU_ALIVE, as the  */
+/* SM-G991N kernel's flexpmu_cal_local_exynos2100.h names them; GPU_ID only  */
+/* if STATUS says the domain is already on. Nothing is written.              */
+static void
+s21_gpu_diag(int level)
+{
+	vm_offset_t pmu = ml_io_map(0x15860000U, 0x4000);
+	uint32_t st = *(volatile uint32_t *)(pmu + 0x2304);
+	note("g3d status=%x", st);
+	uint32_t cfg = *(volatile uint32_t *)(pmu + 0x2300);
+	note("g3d config=%x", cfg);
+	if (st & 1U) {
+		/* Mali GPU_CONTROL block, offsets from the SM-G991N kbase gpu_regmap.h; reads only */
+		vm_offset_t g = ml_io_map(0x18500000U, 0x1000);
+#define GR(o) (*(volatile uint32_t *)(g + (o)))
+		if (level < 3) {
+			note("gpu id=%08x l2f=%08x tilf=%08x memf=%08x", GR(0x000), GR(0x004), GR(0x00C), GR(0x010));
+			note("mmuf=%08x as=%08x js=%08x stat=%08x raw=%08x", GR(0x014), GR(0x018), GR(0x01C), GR(0x034), GR(0x020));
+			note("thr max=%08x wg=%08x bar=%08x feat=%08x", GR(0x0A0), GR(0x0A4), GR(0x0A8), GR(0x0AC));
+			note("shader pres=%08x/%08x rdy=%08x tiler pres=%08x rdy=%08x", GR(0x100), GR(0x104), GR(0x140), GR(0x110), GR(0x150));
+			note("l2 pres=%08x rdy=%08x coh=%08x js0f=%08x js1f=%08x", GR(0x120), GR(0x160), GR(0x300), GR(0x0C0), GR(0x0C4));
+		}
+		if (level >= 2) {
+			/* power-up of the GPU's own blocks through GPU_CONTROL, as panfrost does: */
+			/* L2 first, then the core stack (if the GPU has one), tiler, shaders.      */
+			uint32_t l2p = GR(0x120), tilp = GR(0x110), shp = GR(0x100), stkp = GR(0xE00);
+			uint32_t t0, rdy;
+			note("stack pres=%08x", stkp);
+			GR(0x024) = 0xFFFFFFFFU;                 /* GPU_IRQ_CLEAR */
+#define PWR(onreg, rdyreg, mask, name) do { \
+			GR(onreg) = (mask); \
+			for (t0 = 0; t0 < 200; t0++) { \
+				rdy = GR(rdyreg); \
+				if ((rdy & (mask)) == (mask)) { break; } \
+				sleep_us(1000); \
+			} \
+			note(name " on: rdy=%08x after %ums trans l2=%08x tiler=%08x shader=%08x", rdy, t0, GR(0x220), GR(0x210), GR(0x200)); \
+		} while (0)
+			PWR(0x1A0, 0x160, l2p, "l2");
+			if (stkp) {
+				PWR(0xE20, 0xE10, stkp, "stack");
+			}
+			PWR(0x190, 0x150, tilp, "tiler");
+			PWR(0x180, 0x140, shp, "shader");
+			note("gpu stat=%08x raw=%08x", GR(0x034), GR(0x020));
+			if (level >= 3) {
+				uint64_t scratch = 0;
+				if (PE_parse_boot_argn("gpu_scratch", &scratch, sizeof(scratch)) && scratch) {
+					s21_gpu_job(g, scratch, shp);
+				} else {
+					note("gpu4: no gpu_scratch boot-arg");
+				}
+			}
+			/* back to how S-Boot left it: off, in reverse order */
+			GR(0x1C0) = shp;
+			for (t0 = 0; t0 < 200 && GR(0x140); t0++) { sleep_us(1000); }
+			GR(0x1D0) = tilp;
+			for (t0 = 0; t0 < 200 && GR(0x150); t0++) { sleep_us(1000); }
+			if (stkp) {
+				GR(0xE30) = stkp;
+				for (t0 = 0; t0 < 200 && GR(0xE10); t0++) { sleep_us(1000); }
+			}
+			GR(0x1E0) = l2p;
+			for (t0 = 0; t0 < 200 && GR(0x160); t0++) { sleep_us(1000); }
+			note("off again: shader=%08x tiler=%08x l2=%08x", GR(0x140), GR(0x150), GR(0x160));
+		}
+#undef PWR
