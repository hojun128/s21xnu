+/*
+ * fLock held. The pending swap, copied out for present(), when it may be shown now: on a tick every fFlushTicks
+ * (as before), or (kick) as soon as its GPU work completed. A gated swap whose work is still running stays pending
+ * (counted as a deferral) for at most SWEET_FB_GATE_MAX_TICKS ticks, then is shown anyway (timeout).
+ */
+uint8_t *
+AppleCLCD::takeFrame(bool tick, uint64_t count)
+{
+	if (!fDirty || fPowerOff) {
+		return NULL;
+	}
+	if (tick && (count % fFlushTicks) != 0 && fGateTicks == 0) {
+		return NULL;
+	}
+	if (fGateValid && !sweet_gpu_fence_ready(fGateSlot, fGateGen, fGateTicket)) {
+		if (fPrevValid && sweet_gpu_fence_ready(fPrevSlot, fPrevGen, fPrevTicket)) {
+			/* sweetfb_gate2: the older swap's work is done, the newer one's is not: show the older one now */
+			uint8_t *prec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+			if (prec == NULL) {
+				return NULL;
+			}
+			memcpy(prec, fPrev, SWEET_FB_SWAP_REC_SIZE);
+			fPrevValid = false;
+			fLastPresentAbs = mach_absolute_time();
+			sweet_fb_n_presents++;
+			sweet_fb_n_prev++;
+			if (!tick) {
+				sweet_fb_n_kick++;
+			}
+			if (sweet_fb_n_prev <= 2 || (sweet_fb_n_prev % 500) == 0) {
+				char ln[80];
+				snprintf(ln, sizeof(ln), "fb gate2: %llu older completed frames shown", sweet_fb_n_prev);
+				sweet_mali_log_str(ln);
+			}
+			return prec;
+		}
+		if (!tick) {
+			return NULL;   /* kick before completion (another process's work): wait for the right one */
+		}
+		if (fGateTicks < SWEET_FB_GATE_MAX_TICKS) {
+			fGateTicks++;
+			sweet_fb_n_defer++;
+			return NULL;
+		}
+		sweet_fb_n_timeout++;
+		if (sweet_fb_n_timeout <= 8 || (sweet_fb_n_timeout % 100) == 0) {
+			char ln[96];
+			snprintf(ln, sizeof(ln), "fb gate timeout %llu: ticket %llu not done after %u ticks, shown anyway",
+			    sweet_fb_n_timeout, fGateTicket, fGateTicks);
+			sweet_mali_log_str(ln);
 		}
 	}
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		return NULL;
+	}
+	memcpy(rec, fPending, SWEET_FB_SWAP_REC_SIZE);
+	fDirty = false;
+	fGateValid = false;
+	fGateTicks = 0;
+	fPrevValid = false;   /* older than what is shown now */
+	fLastPresentAbs = mach_absolute_time();
+	sweet_fb_n_presents++;
+	if (!tick) {
+		sweet_fb_n_kick++;
+	}
+	return rec;
+}
