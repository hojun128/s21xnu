+/*
+ * S21 patch 0144: 2-plane YCbCr 4:2:0 layers ('420v' video range, '420f' full range). CoreAnimation hands inline
+ * video (Safari, YouTube) to a display layer of its own; the copy below only handles 4-byte BGRA surfaces, so those
+ * layers were skipped and the video boxes stayed black (runs 238-240: WebKit played the clips, frames decoded).
+ * Converted on the CPU with nearest-neighbour scaling from the layer's source rect (a) to its destination rect (b),
+ * after the BGRA layers (no blending here: the video is drawn last). BT.601 below 720 lines, BT.709 from 720.
+ * Boot-arg sweetfbyuv=0: such layers are skipped as before.
+ */
+static int sweet_fb_yuv_on = -1;
+static uint32_t sweet_fb_yuv_logged;
+
+static bool
+sweet_fb_is_yuv(SweetSurface *s)
+{
+	if (sweet_fb_yuv_on < 0) {
+		int v = 1;
+		PE_parse_boot_argn("sweetfbyuv", &v, sizeof(v));
+		sweet_fb_yuv_on = v != 0;
+	}
+	return sweet_fb_yuv_on && s->planeCount == 2 && (s->pixelFormat == 0x34323076U || s->pixelFormat == 0x34323066U);
+}
 
+static inline uint8_t
+sweet_fb_clamp8(int v)
+{
+	return v < 0 ? 0 : v > 255 ? 255 : (uint8_t)v;
+}
