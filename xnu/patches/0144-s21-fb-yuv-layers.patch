+		int ky = full ? 256 : 298, yo = full ? 0 : 16;
+		int crr = hd ? (full ? 403 : 459) : (full ? 359 : 409);
+		int cbg = hd ? (full ? 48 : 55) : (full ? 88 : 100);
+		int crg = hd ? (full ? 120 : 136) : (full ? 183 : 208);
+		int cbb = hd ? (full ? 475 : 541) : (full ? 454 : 516);
+		const uint8_t *yb = (const uint8_t *)base + py->offset, *cb = (const uint8_t *)base + pc->offset;
+		uint32_t xstep = (uint32_t)(((uint64_t)sw << 16) / (uint32_t)dw), ystep = (uint32_t)(((uint64_t)sh << 16) / (uint32_t)dh);
+		int32_t x0 = dx < 0 ? -dx : 0, y0 = dy < 0 ? -dy : 0;
+		int32_t x1 = dw, y1 = dh;
+		if (dx + x1 > (int32_t)fWidth) {
+			x1 = (int32_t)fWidth - dx;
+		}
+		if (dy + y1 > (int32_t)fHeight) {
+			y1 = (int32_t)fHeight - dy;
+		}
+		for (int32_t y = y0; y < y1; y++) {
+			uint32_t syy = (uint32_t)sy + (uint32_t)(((uint64_t)y * ystep) >> 16);
+			const uint8_t *yr = yb + (uint64_t)syy * py->bytesPerRow;
+			const uint8_t *cr = cb + (uint64_t)(syy >> 1) * pc->bytesPerRow;
+			uint32_t *out = (uint32_t *)(fPixels + (uint64_t)(dy + y) * fRowBytes) + dx;
+			uint32_t fx = (uint32_t)x0 * xstep;
+			for (int32_t x = x0; x < x1; x++, fx += xstep) {
+				uint32_t sxx = (uint32_t)sx + (fx >> 16);
+				int Y = ((int)yr[sxx] - yo) * ky;
+				int U = (int)cr[(sxx & ~1U)] - 128, V = (int)cr[(sxx & ~1U) + 1] - 128;
+				int R = (Y + crr * V + 128) >> 8, G = (Y - cbg * U - crg * V + 128) >> 8, B = (Y + cbb * U + 128) >> 8;
+				out[x] = 0xFF000000U | ((uint32_t)sweet_fb_clamp8(R) << 16) | ((uint32_t)sweet_fb_clamp8(G) << 8) | sweet_fb_clamp8(B);
