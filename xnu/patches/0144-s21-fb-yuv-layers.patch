+		    py->width, py->height, pc->width, pc->height, sx, sy, sw, sh, dx, dy, dw, dh, ok ? "drawn" : "SKIPPED", ns / 1000);
+		sweet_mali_log_str(line);
+	}
+	sweet_fb_yuv_logged++;
+	s->release();
+}
