+		sx = sy = 0;
+		sw = (int32_t)py->width;
+		sh = (int32_t)py->height;
+	}
+	if (sx < 0 || sy < 0 || sx + sw > (int32_t)py->width || sy + sh > (int32_t)py->height) {
+		sx = sy = 0;
+		sw = (int32_t)py->width;
+		sh = (int32_t)py->height;
