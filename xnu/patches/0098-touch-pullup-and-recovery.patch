+/* ------------------------------------------------------------------------ */
+/* 0098-touch-pullup: S-Boot leaves the gpp pads pulled down / floating.     */
+/* Linux's pinctrl sets pull-ups on the i2c pads; bit-banging needs them     */
+/* too, otherwise SCL/SDA idle low, every address ACKs and every read is 0. */
+
+static uint32_t ts_pud_used[2];
+
+static int
+bus_idle_high(struct bbi2c *b)
+{
+	i2c_scl(b, 1);
+	i2c_sda(b, 1);
+	sleep_us(300);
+	return pin_get(b->bank_va, b->scl_bit) && pin_get(b->bank_va, b->sda_bit);
+}
+
+/* returns the PUD field width that made both lines idle high, or 0 */
+static int
+bus_pullup(struct bbi2c *b, int which)
+{
+	uint32_t orig = *(volatile uint32_t *)(b->bank_va + REG_PUD);
+
+	if (bus_idle_high(b)) {
+		ts_pud_used[which] = orig;
+		return 1; /* already high */
 	}
+	for (int w = 2; w <= 4; w += 2) {
+		uint32_t v = orig, m = (1U << w) - 1U;
+		uint32_t pins[2] = { b->scl_bit, b->sda_bit };
+		for (int i = 0; i < 2; i++) {
+			v = (v & ~(m << (pins[i] * (uint32_t)w))) | (3U << (pins[i] * (uint32_t)w));
+		}
+		*(volatile uint32_t *)(b->bank_va + REG_PUD) = v;
+		sleep_us(300);
+		if (bus_idle_high(b)) {
+			ts_pud_used[which] = v;
+			return w;
+		}
+	}
+	*(volatile uint32_t *)(b->bank_va + REG_PUD) = orig;
+	ts_pud_used[which] = orig;
+	return 0;
 }
 
+/* free a slave that is holding SDA low: up to 9 SCL pulses, then STOP */
+static void
+bus_recover(struct bbi2c *b)
+{
+	i2c_sda(b, 1);
+	for (int i = 0; i < 9 && !pin_get(b->bank_va, b->sda_bit); i++) {
+		i2c_scl(b, 0); sleep_us(10);
+		i2c_scl(b, 1); sleep_us(10);
+	}
+	i2c_start(b);
+	i2c_stop(b);
+}
+
+static void
+s2dos05_cycle(void)
+{
+	uint8_t w[2] = { S2DOS05_EN, 0 };
+	uint8_t en;
+	if (!i2c_write_read(&pmic_i2c, S2DOS05_ADDR, w, 1, &en, 1)) {
+		en &= ~((1U << 1) | (1U << 2));
+		w[1] = en;
+		i2c_write(&pmic_i2c, S2DOS05_ADDR, w, 2);
+		sleep_us(100000);
+	}
+	s2dos05_power(1);
+}
+
