diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 1c487b0..1e98440 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -21,6 +21,9 @@
 extern "C" void sweet_secondary_entry(void);
 extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern "C" boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+/* S21 (patch 0138, idea from PixOS 0270/0344, MIT): keep user threads off the Cortex-A55s */
+extern "C" void sched_perfcontrol_update_recommended_cores(uint32_t recommended_cores);
+extern "C" void sweet_mali_log_str(const char *s);
 
 class SweetCPU;
 static SweetCPU *sweet_cpus[MAX_CPUS];
@@ -176,6 +179,28 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	ml_set_max_cpus(topology->max_cpu_id + 1);
 	IOLog("SWEET CPU: %u/%u CPUs initialized, SGI1 verified\n",
 	    topology->num_cpus, topology->num_cpus);
+	/*
+	 * Boot-arg sweetrecores=MASK (S21: cpus 0-3 Cortex-A55, 4-6 A78, 7 X1; 0xf0 = big cores only). The ADT describes
+	 * one homogeneous cluster, so the scheduler ran UI threads (backboardd's render server, SpringBoard) on the slow
+	 * A55s as often as on the big cores. Recommended cores is a scheduler hint: the other cores stay online for
+	 * interrupts and bound kernel threads. Applied here, once every CPU is online (an earlier call is undone because
+	 * no requested core is online yet: PixOS 0344). Scheduler state only, no hardware access.
+	 */
+	{
+		uint32_t rc = 0;
+		uint32_t all = topology->num_cpus >= 32 ? 0xffffffffu : ((1u << topology->num_cpus) - 1u);
+		if (PE_parse_boot_argn("sweetrecores", &rc, sizeof(rc)) && rc != 0) {
+			char ln[96];
+			if ((rc & all) != 0 && (rc & ~all) == 0) {
+				sched_perfcontrol_update_recommended_cores(rc);
+				snprintf(ln, sizeof(ln), "dvfs sched: recommended cores 0x%x of 0x%x", rc, all);
+			} else {
+				snprintf(ln, sizeof(ln), "dvfs sched: sweetrecores=0x%x refused (cpus 0x%x)", rc, all);
+			}
+			IOLog("SWEET CPU: %s\n", ln);
+			sweet_mali_log_str(ln);
+		}
+	}
 	thread_terminate(current_thread());
 }
 
