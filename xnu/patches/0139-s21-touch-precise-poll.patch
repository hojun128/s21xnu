+/*
+ * S21 (patch 0139): the poll sleep is an absolute deadline with no coalescing leeway (assert_wait_timeout's default
+ * leeway let 8 ms sleeps run long), and while a finger is on the panel (an event in the last 120 ms) ATTN is sampled
+ * every touch_poll_active_us (default 4000 us) instead of touch_poll_us: less touch-to-screen latency in drags.
+ * touch_poll_active_us=0 keeps the old timing.
+ */
+static uint32_t ts_g_active_us = 4000;
+static uint64_t ts_g_last_ev_abs;
+/* touch statistics every 10 s with events (kept log line "keys: touch ..."): tells real use from ghost touches */
+extern void sweet_mali_log_str(const char *s);
+static uint32_t ts_st_ev, ts_st_down, ts_st_ids, ts_st_lines; static int ts_st_x, ts_st_y; static uint64_t ts_st_t0;
+static void
+ts_stat(const struct ts_touch *t)
+{
+	uint64_t now = mach_absolute_time(), win = 0;
+	ts_st_ev++; ts_st_down += t->down ? 1 : 0; ts_st_ids |= 1u << (t->id & 15); ts_st_x = t->x; ts_st_y = t->y;
+	nanoseconds_to_absolutetime(10ULL * NSEC_PER_SEC, &win);
+	if (!ts_st_t0) {
+		ts_st_t0 = now;
+	} else if (now - ts_st_t0 >= win) {
+		if (ts_st_lines++ < 120) {
+			char ln[112];
+			snprintf(ln, sizeof(ln), "keys: touch 10s ev %u down %u ids %x last %d,%d z %d", ts_st_ev, ts_st_down, ts_st_ids,
+			    (ts_st_x * 1080) >> 12, (ts_st_y * 2400) >> 12, t->z);
+			sweet_mali_log_str(ln);
+		}
+		ts_st_ev = ts_st_down = ts_st_ids = 0; ts_st_t0 = now;
+	}
+}
+
 static void
 ts_block_us(uint32_t us)
 {
-	assert_wait_timeout((event_t)&ts_g_ev, THREAD_UNINT, us, NSEC_PER_USEC);
+	uint64_t now = mach_absolute_time(), dl = 0;
+	if (ts_g_active_us) {
+		uint64_t act = 0;
+		nanoseconds_to_absolutetime(120ULL * NSEC_PER_MSEC, &act);
+		if (ts_g_last_ev_abs && now - ts_g_last_ev_abs < act && ts_g_active_us < us) {
+			us = ts_g_active_us;
+		}
+		nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &dl);
+		assert_wait_deadline_with_leeway((event_t)&ts_g_ev, THREAD_UNINT,
+		    TIMEOUT_URGENCY_SYS_CRITICAL | TIMEOUT_URGENCY_LEEWAY, now + dl, 0);
+	} else {
+		assert_wait_timeout((event_t)&ts_g_ev, THREAD_UNINT, us, NSEC_PER_USEC);
+	}
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * Stuck-finger guard (patch 0139, idea from N1709/z3sios redwood_sec_ts.c, MIT): the controller answers an
+ * overflow or a lost state with an EMPTY event (eid 3) or keeps ATTN low with nothing to read; a finger whose
+ * release event was lost stayed "down" in iOS (run182: Settings redrawn 13 times a second for 80 s with nobody
+ * touching). Then: clear the controller's event stack and post a release for every finger still down.
+ * ATTN low 1 s with no event: the same; 5 s: sensing on again.
+ */
+static uint32_t ts_g_released;
+static void
+ts_release_all(const char *why)
+{
+	uint8_t c = SEC_TS_CMD_CLEAR_EVENT_STACK;
+	uint32_t n = 0;
+	i2c_write(&ts_i2c, SEC_TS_ADDR, &c, 1);
+	for (int i = 0; i < 16; i++) {
+		if (ts_fing[i].down) {
+			ts_fing[i].down = 0;
+			sweet_hid_touch(i, 0, ts_fing[i].x, ts_fing[i].y);
+			n++;
+		}
+	}
+	if (ts_g_released++ < 40) {
+		char ln[96];
+		snprintf(ln, sizeof(ln), "keys: touch reset (%s): %u finger(s) released", why, n);
+		sweet_mali_log_str(ln);
+	}
+}
